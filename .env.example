# Voice API (SpeechClient → Whisper)
VOICE_API_BASE_URL=https://your-voice-api.example.com
VOICE_API_BEARER_TOKEN=your-bearer-token

# OpenAI for structured wine parsing (not Whisper — that goes through the voice API)
OPENAI_API_KEY=sk-...
OPENAI_WINE_MODEL=gpt-4o-mini

# Optional: ffmpeg input device (macOS default ":0")
# SPEECH_RECORD_DEVICE=:0
